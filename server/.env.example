NODE_ENV=development
PORT=4000

# MongoDB connection string (Atlas or local, e.g. mongodb://localhost:27017)
MONGODB_URI=
MONGODB_DB=melty

# Admin login. The password is stored only as a bcrypt hash:
#   npm run hash-password -- "your-password"
# Wrap the hash in single quotes.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=''
# Long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_HOURS=12

# Comma-separated allowed client origins
CLIENT_ORIGIN=http://localhost:5173

# Who may set X-Forwarded-For (affects rate limiting). "loopback" = the local
# dev proxy only. Behind one reverse proxy / host load balancer in production: 1
TRUST_PROXY=loopback
